<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="decafirma_document_view_list" model="ir.ui.view">
        <field name="name">decafirma.document.list</field>
        <field name="model">decafirma.document</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'anulado'" create="0" edit="0">
                <field name="kind"/>
                <field name="reference"/>
                <field name="version"/>
                <field name="state" widget="badge" decoration-success="state == 'vigente'"/>
                <field name="is_demo" optional="hide"/>
                <field name="url" widget="url" text="QR" string="QR"/>
                <field name="sign_url" widget="url" text="Firmar" string="Firma" optional="show" invisible="not sign_url or signed_at or state == 'anulado'"/>
                <field name="signed_at" optional="show"/>
                <field name="signed_by" optional="show"/>
                <field name="signed_remarks" optional="show" string="Reservas"/>
                <field name="void_reason" optional="hide"/>
                <button name="action_download_pdf" type="object" string="PDF" icon="download"/>
                <button name="action_enviar" type="object" groups="decafirma.group_decafirma_user" string="Al conductor" icon="mail" invisible="state == 'anulado'"/>
                <button name="action_anular" type="object" groups="decafirma.group_decafirma_manager" string="Anular" icon="close" invisible="state == 'anulado'"/>
            </list>
        </field>
    </record>

    <record id="decafirma_shipment_view_list" model="ir.ui.view">
        <field name="name">decafirma.shipment.list</field>
        <field name="model">decafirma.shipment</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="res_model" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('documented', 'delivered')" decoration-warning="state == 'draft'"/>
                <field name="signed" optional="show"/>
                <field name="signed_by" optional="show"/>
                <field name="route_stop" optional="hide"/>
                <field name="error" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="decafirma_shipment_view_form" model="ir.ui.view">
        <field name="name">decafirma.shipment.form</field>
        <field name="model">decafirma.shipment</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_actualizar" type="object" groups="decafirma.group_decafirma_user" string="Actualizar"/>
                    <button name="action_abrir_origen" type="object" string="Abrir el origen"/>
                    <field name="state" widget="statusbar" statusbar_visible="documented,delivered"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not error">
                        <field name="error"/>
                    </div>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="deca_url" widget="url" text="Ver el DeCA"/>
                            <field name="albaran_sign_url" widget="url" text="Enlace de firma" invisible="not albaran_sign_url"/>
                            <field name="signed_by" invisible="not signed"/>
                        </group>
                        <group>
                            <field name="deca_id" readonly="1"/>
                            <field name="route_deca_id" readonly="1" invisible="not route_deca_id"/>
                            <field name="route_stop" readonly="1" invisible="not route_deca_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <field name="document_ids" readonly="1"/>
                    <field name="papel_ids" readonly="1" invisible="not papel_ids"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="decafirma_shipment_view_search" model="ir.ui.view">
        <field name="name">decafirma.shipment.search</field>
        <field name="model">decafirma.shipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="sin_firmar" string="Albarán sin firmar" domain="[('signed', '=', False), ('state', '=', 'documented')]"/>
                <filter name="firmados" string="Firmados" domain="[('signed', '=', True)]"/>
                <filter name="con_aviso" string="Con aviso" domain="[('error', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="decafirma_shipment_action" model="ir.actions.act_window">
        <field name="name">Envíos en DecaFirma</field>
        <field name="res_model">decafirma.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay nada emitido en DecaFirma</p>
            <p>Se emite desde el albarán de salida (Inventario) o desde el servicio del TMS.</p>
        </field>
    </record>
</odoo>
