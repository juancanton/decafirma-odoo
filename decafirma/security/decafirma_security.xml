        <field name="name">DecaFirma documentos: multiempresa</field>
        <field name="model_id" ref="model_decafirma_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_decafirma_papel_company" model="ir.rule">
        <field name="name">DecaFirma papeles: multiempresa</field>
        <field name="model_id" ref="model_decafirma_papel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
