<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Como en DecaFirma: quien emite (Usuario) y quien además anula y lleva los ajustes (Responsable).
         Al instalar, Usuario para todos los usuarios internos (ver hooks.py): se quita a quien no deba emitir. -->
    <record id="module_category_decafirma" model="ir.module.category">
        <field name="name">DecaFirma</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">40</field>
    </record>
    <record id="group_decafirma_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_decafirma"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Emite el DeCA y el albarán, lleva los cambios a DecaFirma y los manda al conductor.</field>
    </record>
    <record id="group_decafirma_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_decafirma"/>
        <field name="implied_ids" eval="[(4, ref('group_decafirma_user'))]"/>
        <field name="comment">Además anula documentos. Los ajustes de DecaFirma, quien administra Odoo.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <!-- Quien administra Odoo es Responsable: lleva los ajustes de DecaFirma. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_decafirma_manager'))]"/>
    </record>
</odoo>
